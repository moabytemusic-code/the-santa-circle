# ==========================================
# The Santa Circle - Environment Variables
# ==========================================

# Node Environment
NODE_ENV=production
PORT=3000

# Application URL (Used for invitation links, webhooks, and password reset emails)
NEXT_PUBLIC_APP_URL=https://thesantacircle.com

# PostgreSQL Database Connection
# In Docker: postgresql://postgres:your_secure_password@db:5432/santacircle?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/santacircle?schema=public"

# Session & JWT Secret (Generate with: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-very-long-random-secret-key-at-least-32-chars"

# Brevo (Sendinblue) Transactional Email API
# Get key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=""
EMAIL_FROM_ADDRESS="invites@thesantacircle.com"
EMAIL_FROM_NAME="The Santa Circle"

# Stripe Monetization (Host Pass $7.99 Checkout & Webhook)
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Amazon Associates Affiliate Tag
# Auto-tagged on all Amazon wishlist links
AMAZON_AFFILIATE_TAG="santa101-20"

# Music Storage Configuration
UPLOAD_DIR="./uploads/music"
MAX_UPLOAD_SIZE_MB=15

# Admin Seed Account (Optional: auto-seeded on first run if configured)
ADMIN_DEFAULT_EMAIL="admin@thesantacircle.com"
ADMIN_DEFAULT_PASSWORD="ChangeMeInProduction123!"
ADMIN_DEFAULT_NAME="Circle Host"
